  "candidate_driver": "use cntryl_midge::{Engine, OpenOptions, TransactionMode, WriteOptions};\nuse serde_json::json;\nuse std::{fs, time::{Duration, Instant}};\nfn journal(path: &std::path::Path) -> (usize,usize,usize) {\n    let b=fs::read(path.join(\"manifest.journal\")).unwrap_or_default();\n    let mut at=0; let mut records=0; let mut largest=0;\n    while at<b.len() {\n        assert!(at+9<=b.len());\n        let len=u32::from_le_bytes(b[at+1..at+5].try_into().unwrap()) as usize;\n        assert!(at+len+9<=b.len());\n        if b[at]!=9 {records+=1; largest=largest.max(len+9);}\n        at+=len+9;\n    }\n    (b.len(),records,largest)\n}\nfn main() {\n    let mut rows=vec![];\n    for repeat in 1..=5 { for (cycles,key_bytes) in [(1,32),(15,32),(16,32),(31,32),(15,2048)] {\n        let dir=tempfile::tempdir().unwrap();\n        let opts=OpenOptions::local(dir.path()).background_compaction(false).build().unwrap();\n        let mut engine=Engine::open(opts.clone()).unwrap();\n        let cfs=(0..4).map(|i|engine.create_column_family(&format!(\"data-{i}\")).unwrap()).collect::<Vec<_>>();\n        let mut peak_bytes=0;let mut peak_records=0;let mut peak_record_bytes=0;\n        for n in 0..cycles {\n            let cf=&cfs[n%4];\n            let mut tx=engine.begin_tx(cf.id(),TransactionMode::ReadWrite).unwrap();\n            let mut key=vec![b'k';key_bytes]; key[..8].copy_from_slice(&(n as u64).to_be_bytes());\n            tx.put(key,vec![n as u8;128],None).unwrap();tx.commit(WriteOptions::sync()).unwrap();\n            engine.flush_cf(cf).unwrap();\n            let (bytes,count,record)=journal(dir.path());\n            peak_bytes=peak_bytes.max(bytes);peak_records=peak_records.max(count);peak_record_bytes=peak_record_bytes.max(record);\n        }\n        engine.shutdown(Duration::from_secs(10)).unwrap();drop(engine);\n        let tail=journal(dir.path());\n        let start=Instant::now();let mut reopened=Engine::open(opts).unwrap();let reopen_ns=start.elapsed()