FROM rust:trixie

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		pkg-config \
		libssl-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy

WORKDIR /workspace

# Copy the full repository and build every registered benchmark target.
COPY . .

RUN cargo bench --workspace --all-features --no-run

CMD ["cargo", "bench", "--workspace", "--all-features"]
