FROM rust:trixie

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		pkg-config \
		libssl-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Verify the crate in a clean Debian container.
COPY . .

# .git stays outside the image. CI supplies the exact clean checkout provenance;
# ordinary source archives remain unqualified when those inputs are omitted.
ARG MIDGE_DISCOVERY_SOURCE_REVISION
ARG MIDGE_DISCOVERY_SOURCE_DIRTY=true

# Start the compose.yml Sqrzl fixture first and build with --network=host.
# This disposable emulator credential matches that fixture, not a cloud account.
# Failpoints are process-global, so the all-features suite must run serially.
RUN SQRZL_SECRET_ACCESS_KEY=easy-peasy \
    MIDGE_DISCOVERY_SOURCE_REVISION="${MIDGE_DISCOVERY_SOURCE_REVISION}" \
    MIDGE_DISCOVERY_SOURCE_DIRTY="${MIDGE_DISCOVERY_SOURCE_DIRTY}" \
    cargo test --workspace --all-features -- --test-threads=1

CMD ["bash"]
