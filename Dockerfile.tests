FROM rust:trixie

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		pkg-config \
		libssl-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy

WORKDIR /workspace

# Copy the full repository and run the same quality gates we expect in CI.
COPY . .

RUN cargo clippy --all-targets --all-features -- -D warnings
RUN cargo build --all-targets
RUN cargo test --lib --features uring
RUN cargo test

CMD ["bash"]
