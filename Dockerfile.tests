FROM rust:trixie

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		pkg-config \
		libssl-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

RUN rustup component add clippy rustfmt

WORKDIR /workspace

# Copy the full repository and run the same feature gates we expect in CI.
COPY . .

RUN cargo fmt --check
RUN cargo clippy --workspace --all-targets --all-features -- -D warnings -D clippy::pedantic
RUN cargo test --workspace --all-features
RUN cargo clippy --workspace --all-targets --no-default-features -- -D warnings -D clippy::pedantic
RUN cargo check --workspace --all-targets --no-default-features --features cloud-aws
RUN cargo check --workspace --all-targets --no-default-features --features cloud-azure
RUN cargo check --workspace --all-targets --no-default-features --features cloud-gcp
RUN cargo check --workspace --all-targets --no-default-features --features cloud-oci

CMD ["bash"]
