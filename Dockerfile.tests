FROM rust:trixie

RUN apt-get update \
	&& apt-get install -y --no-install-recommends \
		build-essential \
		pkg-config \
		libssl-dev \
		ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Verify the crate in a clean Debian container.
COPY . .

# Failpoints are process-global, so the all-features suite must run serially.
RUN cargo test --workspace --all-features -- --test-threads=1

CMD ["bash"]
